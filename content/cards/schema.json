{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dokimon/dokimon/content/cards/schema.json",
  "title": "Dokimon Card Catalog",
  "type": "array",
  "minItems": 1,
  "items": { "$ref": "#/$defs/card" },
  "$defs": {
    "element": { "enum": ["Fire", "Water", "Earth", "Air", "Void"] },
    "rarity": {
      "enum": ["Common", "Uncommon", "Rare", "Epic", "Legendary", "Master"]
    },
    "keyword": { "enum": ["charge", "pierce", "lifesteal"] },
    "httpsUrl": {
      "type": "string",
      "pattern": "^https://[^\\s]+$",
      "minLength": 12,
      "maxLength": 500
    },
    "status": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value", "turns"],
      "properties": {
        "kind": { "enum": ["burn", "freeze", "shield", "rally"] },
        "value": { "type": "integer", "minimum": 0, "maximum": 200 },
        "turns": { "type": "integer", "minimum": 1, "maximum": 3 }
      }
    },
    "ability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type", "cost", "target", "power", "text"],
      "properties": {
        "name": { "type": "string", "minLength": 2, "maxLength": 40 },
        "type": { "enum": ["attack", "heal", "buff", "control", "shield"] },
        "cost": { "type": "integer", "minimum": 0, "maximum": 10 },
        "target": {
          "enum": [
            "enemy_unit",
            "any_unit",
            "self",
            "all_enemy_units",
            "all_allies",
            "enemy_player"
          ]
        },
        "power": { "type": "integer", "minimum": 0, "maximum": 300 },
        "status": { "oneOf": [{ "$ref": "#/$defs/status" }, { "type": "null" }] },
        "text": { "type": "string", "minLength": 5, "maxLength": 160 }
      }
    },
    "card": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "element",
        "rarity",
        "type",
        "cost",
        "hp",
        "attack",
        "defense",
        "keywords",
        "ability",
        "imageUrl",
        "obtainable",
        "version"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^card_[a-z0-9_]{3,32}$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 40 },
        "element": { "$ref": "#/$defs/element" },
        "rarity": { "$ref": "#/$defs/rarity" },
        "type": { "enum": ["unit", "spell"] },
        "cost": { "type": "integer", "minimum": 0, "maximum": 10 },
        "hp": { "type": ["integer", "null"], "minimum": 1, "maximum": 999 },
        "attack": { "type": ["integer", "null"], "minimum": 0, "maximum": 999 },
        "defense": { "type": ["integer", "null"], "minimum": 0, "maximum": 999 },
        "keywords": {
          "type": "array",
          "maxItems": 3,
          "items": { "$ref": "#/$defs/keyword" }
        },
        "ability": {
          "oneOf": [{ "$ref": "#/$defs/ability" }, { "type": "null" }]
        },
        "flavorText": { "type": "string", "maxLength": 200 },
        "imageUrl": { "$ref": "#/$defs/httpsUrl" },
        "thumbnailUrl": { "$ref": "#/$defs/httpsUrl" },
        "model3dUrl": {
          "oneOf": [{ "$ref": "#/$defs/httpsUrl" }, { "type": "null" }]
        },
        "obtainable": { "type": "boolean" },
        "retired": { "type": "boolean" },
        "version": { "type": "integer", "minimum": 1 }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "unit" } } },
          "then": {
            "properties": {
              "hp": { "type": "integer", "minimum": 1 },
              "attack": { "type": "integer", "minimum": 0 },
              "defense": { "type": "integer", "minimum": 0 }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "spell" } } },
          "then": {
            "properties": {
              "hp": { "type": "null" },
              "attack": { "type": "null" },
              "defense": { "type": "null" }
            },
            "required": ["ability"]
          }
        }
      ]
    }
  }
}
