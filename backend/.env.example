# ─── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=8080
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ─── Database ─────────────────────────────────────────────────────────────────
# Dev (default, zero config): SQLite
DATABASE_URL="file:./dev.db"
#
# Supabase Postgres (uncomment setelah mengisi password DB):
# DATABASE_URL="postgresql://postgres.<project-ref>:<DB_PASSWORD>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# lalu jalankan:  npm run db:generate:pg && npm run db:push:pg
#
# Supabase project: https://volhmfppofsxuupzvdvn.supabase.co
# Publishable key (aman untuk client, TIDAK bisa dipakai backend untuk akses DB):
#   sb_publishable_B2QlGZdGoAAMD_eQqXDXdA_Fme40Kca
# Backend butuh DATABASE_URL di atas (Settings → Database → Connection string).

# ─── Auth ─────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=replace_with_32+_random_chars
JWT_REFRESH_SECRET=replace_with_32+_random_chars
ACCESS_TTL_MINUTES=15
REFRESH_TTL_DAYS=30

# ─── GitHub CMS (katalog kartu) ───────────────────────────────────────────────
GITHUB_OWNER=dokimon
GITHUB_REPO=dokimon
GITHUB_REF=main
CATALOG_CDN_BASE=https://cdn.jsdelivr.net/gh
CATALOG_RAW_BASE=https://raw.githubusercontent.com
CATALOG_SYNC_INTERVAL_MS=900000
CATALOG_FETCH_TIMEOUT_MS=8000
# Path file lokal (fallback offline / bootstrap). Relatif terhadap folder backend.
CATALOG_LOCAL_PATH=../content/cards/cards.json
CATALOG_MANIFEST_LOCAL_PATH=../content/cards/manifest.json
GITHUB_TOKEN=
ADMIN_TOKEN=replace_with_admin_token

# ─── Supabase (opsional, hanya untuk info/asset base) ─────────────────────────
SUPABASE_URL=https://volhmfppofsxuupzvdvn.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_B2QlGZdGoAAMD_eQqXDXdA_Fme40Kca

LOG_LEVEL=info
