# Salin ke .env.local lalu sesuaikan. Hanya variabel NEXT_PUBLIC_* yang
# dibundel ke browser — JANGAN taruh secret di sini (invarian I-09).

# true (default) = mode offline tanpa login & tanpa backend (data di localStorage).
# false = mode server: login + Express API.
NEXT_PUBLIC_OFFLINE=true

# Base URL Express API (mode server). Backend default mengizinkan CORS dari
# http://localhost:3000 (lihat backend/.env.example CORS_ORIGINS).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1
